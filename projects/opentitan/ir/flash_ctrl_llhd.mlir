    %flash_mp_err_i_1 = llhd.sig name "flash_mp_err_i" %false : i1
    %oob_err = llhd.sig %false : i1
    %2 = comb.and %op_start_i, %op_addr_oob_i : i1
    llhd.drv %oob_err, %2 after %0 : i1
    %3 = llhd.prb %oob_err : i1
    %4 = comb.or %flash_done_i, %3 : i1
    %5 = comb.and %10, %4 : i1
    llhd.drv %op_done_o, %5 after %0 : i1
    %6 = llhd.prb %op_err_o : !hw.struct<invalid_op_err: i1, oob_err: i1, mp_err: i1, rd_err: i1, prog_err: i1, prog_win_err: i1, prog_type_err: i1>
    %7 = llhd.prb %op_done_o : i1
    %8 = llhd.prb %flash_mp_err_i_1 : i1
    llhd.process {
      cf.br ^bb1
    ^bb1:  // 2 preds: ^bb0, ^bb1
      llhd.drv %op_err_o, %1 after %0 : !hw.struct<invalid_op_err: i1, oob_err: i1, mp_err: i1, rd_err: i1, prog_err: i1, prog_win_err: i1, prog_type_err: i1>
