      %19 = llhd.prb %op_done_o : i1
      %20 = llhd.prb %oob_err : i1
      %21 = comb.and %19, %20 : i1
      llhd.drv %18, %21 after %0 : i1
      %22 = llhd.sig.struct_extract %op_err_o["mp_err"] : <!hw.struct<invalid_op_err: i1, oob_err: i1, mp_err: i1, rd_err: i1, prog_err: i1, prog_win_err: i1, prog_type_err: i1>>
      %23 = llhd.prb %op_done_o : i1
      %24 = llhd.prb %flash_mp_err_i_1 : i1
      %25 = comb.and %23, %24 : i1
      llhd.drv %22, %25 after %0 : i1
      llhd.wait (%6, %7, %3, %8 : !hw.struct<invalid_op_err: i1, oob_err: i1, mp_err: i1, rd_err: i1, prog_err: i1, prog_win_err: i1, prog_type_err: i1>, i1, i1, i1), ^bb1
    }
    %9 = comb.xor %op_addr_oob_i, %true : i1
    %10 = comb.and %op_start_i, %9 : i1
    %11 = comb.xor %op_type_i, %true : i1
    %12 = llhd.prb %op_addr_i_0 : i18
    %13 = comb.extract %12 from 9 : (i18) -> i9
    %14 = comb.concat %13, %c0_i9 : i9, i9
    %15 = comb.extract %12 from 17 : (i18) -> i1
    %16 = comb.concat %15, %c0_i17 : i1, i17
    %17 = comb.mux %11, %14, %16 : i18
    llhd.drv %op_addr_i_0, %op_addr_i after %0 : i18
    llhd.drv %flash_mp_err_i_1, %flash_mp_err_i after %0 : i1
    hw.output %7, %6, %17, %10, %17, %op_type_i : i1, !hw.struct<invalid_op_err: i1, oob_err: i1, mp_err: i1, rd_err: i1, prog_err: i1, prog_win_err: i1, prog_type_err: i1>, i18, i1, i18, i1
  }
