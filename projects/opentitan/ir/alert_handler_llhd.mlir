    hw.output %u_reg_wrap.tl_o, %478, %497, %513, %529, %u_reg_wrap.crashdump_o, %u_edn_req.edn_o, %628, %629 : !hw.struct<d_valid: i1, d_opcode: i3, d_param: i3, d_size: i2, d_source: i8, d_sink: i1, d_data: i32, d_user: !hw.struct<rsp_intg: i7, data_intg: i7>, d_error: i1, a_ready: i1>, i1, i1, i1, i1, !hw.struct<alert_cause: i65, loc_alert_cause: i7, class_accum_cnt: !hw.array<4xi16>, class_esc_cnt: !hw.array<4xi32>, class_esc_state: !hw.array<4xi3>>, !hw.struct<edn_req: i1>, !hw.array<65xstruct<ping_p: i1, ping_n: i1, ack_p: i1, ack_n: i1>>, !hw.array<4xstruct<esc_p: i1, esc_n: i1>>
