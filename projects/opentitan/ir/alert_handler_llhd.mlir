  hw.module private @prim_packer_fifo(in %clk_i : i1, in %rst_ni : i1, in %clr_i : i1, in %wvalid_i : i1, in %wdata_i : i32, out wready_o : i1, out rvalid_o : i1, out rdata_o : i32, in %rready_i : i1, out depth_o : i1) {
