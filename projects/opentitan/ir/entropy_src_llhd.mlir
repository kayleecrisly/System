    %13 = comb.and %12, %postht_fifo_not_empty_i : i1
    %14 = comb.and %12, %distr_fifo_not_empty_i : i1
    %15 = comb.concat %esrng_fifo_not_empty_i, %esbit_fifo_not_empty_i, %13, %14 {sv.namehint = "fifos_not_empty"} : i1, i1, i1, i1
