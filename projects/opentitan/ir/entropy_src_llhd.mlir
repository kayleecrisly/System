    %17 = comb.icmp ne %15, %c0_i4 : i4
    %18 = comb.and %16, %17 {sv.namehint = "data_in_flight"} : i1
    %19 = comb.extract %8 from 0 : (i4) -> i1
    %20 = comb.or %19, %18 : i1
    %21 = comb.xor %enable_i, %true : i1
    %22 = comb.and %20, %21 : i1
    llhd.drv %extend_enable, %22 after %0 : i1
    %23 = comb.and %sha3_block_busy_i, %21 : i1
    %24 = llhd.prb %sha3_block_processed_q : i1
    %25 = llhd.prb %sha3_active_post_en_q : i1
    %26 = comb.xor %24, %true : i1
    %27 = comb.and %26, %25 : i1
    %28 = comb.or %23, %27 : i1
    llhd.drv %sha3_active_post_en_d, %28 after %0 : i1
    %29 = llhd.prb %extend_enable_q : i1
    %30 = comb.or %25, %29 {sv.namehint = "suppress_reenable"} : i1
    llhd.drv %clk_i_0, %clk_i after %0 : i1
    llhd.drv %rst_ni_1, %rst_ni after %0 : i1
    llhd.drv %sha3_block_processed_i_2, %sha3_block_processed_i after %0 : i1
    hw.output %7 : i1
  }
