  hw.module private @entropy_src_enable_delay(in %clk_i : i1, in %rst_ni : i1, in %enable_i : i1, in %esrng_fifo_not_empty_i : i1, in %esbit_fifo_not_empty_i : i1, in %postht_fifo_not_empty_i : i1, in %distr_fifo_not_empty_i : i1, in %sha3_block_busy_i : i1, in %sha3_block_processed_i : i1, in %bypass_mode_i : i1, out enable_o : i1) {
