    %5 = comb.and %enable_i, %4 : i1
    %6 = llhd.prb %extend_enable : i1
    %7 = comb.or %5, %6 : i1
    %8 = llhd.prb %fifo_timer_q : i4
    %9 = comb.extract %8 from 0 : (i4) -> i3
    %10 = comb.concat %9, %false : i3, i1
