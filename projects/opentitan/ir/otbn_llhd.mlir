  hw.module private @prim_packer_fifo(in %clk_i : i1, in %rst_ni : i1, in %clr_i : i1, in %wvalid_i : i1, in %wdata_i : i32, out wready_o : i1, out rvalid_o : i1, out rdata_o : i256, in %rready_i : i1, out depth_o : i4) {
    %c0_i247 = hw.constant 0 : i247
    %c0_i5 = hw.constant 0 : i5
    %c0_i224 = hw.constant 0 : i224
    %0 = llhd.constant_time <0ns, 0d, 1e>
    %1 = llhd.constant_time <0ns, 1d, 0e>
