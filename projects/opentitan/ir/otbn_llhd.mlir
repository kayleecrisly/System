    %depth_d = llhd.sig %c0_i4 : i4
    %data_q = llhd.sig %c0_i256 : i256
    %data_d = llhd.sig %c0_i256 : i256
    %clr_q = llhd.sig %false : i1
    %clr_d = llhd.sig %false : i1
    llhd.process {
      cf.br ^bb1
    ^bb1:  // 4 preds: ^bb0, ^bb2, ^bb4, ^bb5
      %28 = llhd.prb %clk_i_0 : !hw.inout<i1>
      %29 = llhd.prb %rst_ni_1 : !hw.inout<i1>
      llhd.wait (%2, %3 : i1, i1), ^bb2
    ^bb2:  // pred: ^bb1
      %30 = llhd.prb %clk_i_0 : !hw.inout<i1>
      %31 = comb.xor bin %28, %true : i1
      %32 = comb.and bin %31, %30 : i1
      %33 = llhd.prb %rst_ni_1 : !hw.inout<i1>
      %34 = comb.xor bin %33, %true : i1
      %35 = comb.and bin %29, %34 : i1
      %36 = comb.or bin %32, %35 : i1
      cf.cond_br %36, ^bb3, ^bb1
    ^bb3:  // pred: ^bb2
      %37 = llhd.prb %rst_ni_1 : !hw.inout<i1>
      %38 = comb.xor %37, %true : i1
      cf.cond_br %38, ^bb4, ^bb5
    ^bb4:  // pred: ^bb3
      llhd.drv %depth_q, %c0_i4 after %1 : !hw.inout<i4>
      llhd.drv %data_q, %c0_i256 after %1 : !hw.inout<i256>
      llhd.drv %clr_q, %true after %1 : !hw.inout<i1>
      cf.br ^bb1
    ^bb5:  // pred: ^bb3
      %39 = llhd.prb %depth_d : !hw.inout<i4>
      llhd.drv %depth_q, %39 after %1 : !hw.inout<i4>
      %40 = llhd.prb %data_d : !hw.inout<i256>
      llhd.drv %data_q, %40 after %1 : !hw.inout<i256>
      %41 = llhd.prb %clr_d : !hw.inout<i1>
      llhd.drv %clr_q, %41 after %1 : !hw.inout<i1>
      cf.br ^bb1
    }
    llhd.drv %clr_d, %clr_i after %0 : !hw.inout<i1>
    %4 = llhd.prb %depth_q : !hw.inout<i4>
    %gen_pack_mode.wdata_shifted = llhd.sig %c0_i256 : i256
    %5 = comb.concat %c0_i224, %wdata_i : i224, i32
    %6 = comb.concat %c0_i247, %4, %c0_i5 : i247, i4, i5
    %7 = comb.shl %5, %6 : i256
    llhd.drv %gen_pack_mode.wdata_shifted, %7 after %0 : !hw.inout<i256>
    %8 = comb.and %rready_i, %27 : i1
    %9 = llhd.prb %clr_q : !hw.inout<i1>
    %10 = comb.or %8, %9 {sv.namehint = "clear_status"} : i1
    %11 = comb.and %wvalid_i, %26 : i1
    llhd.drv %load_data, %11 after %0 : !hw.inout<i1>
    %12 = llhd.prb %load_data : !hw.inout<i1>
    %13 = comb.add %4, %c1_i4 : i4
    %14 = comb.mux %12, %13, %4 : i4
    %15 = comb.mux %10, %c0_i4, %14 : i4
    llhd.drv %depth_d, %15 after %0 : !hw.inout<i4>
    %16 = llhd.prb %gen_pack_mode.wdata_shifted : !hw.inout<i256>
    %17 = comb.icmp eq %4, %c0_i4 : i4
    %18 = llhd.prb %data_q : !hw.inout<i256>
    %19 = comb.mux %17, %c0_i256, %18 : i256
    %20 = comb.or %16, %19 : i256
    %21 = comb.mux %12, %20, %18 : i256
    %22 = comb.mux %9, %c0_i256, %21 : i256
    llhd.drv %data_d, %22 after %0 : !hw.inout<i256>
    %23 = comb.icmp eq %4, %c-8_i4 : i4
    %24 = comb.xor %23, %true : i1
    %25 = comb.xor %9, %true : i1
    %26 = comb.and %24, %25 : i1
    %27 = comb.and %23, %25 : i1
    llhd.drv %clk_i_0, %clk_i after %0 : !hw.inout<i1>
    llhd.drv %rst_ni_1, %rst_ni after %0 : !hw.inout<i1>
