  hw.module private @pinmux_wkup(in %clk_i : i1, in %rst_ni : i1, in %wkup_en_i : i1, in %filter_en_i : i1, in %wkup_mode_i : i3, in %wkup_cnt_th_i : i8, in %pin_value_i : i1, out aon_wkup_pulse_o : i1) {
    %0 = llhd.constant_time <0ns, 1d, 0e>
    %true = hw.constant true
    %1 = llhd.constant_time <0ns, 0d, 1e>
    %c0_i3 = hw.constant 0 : i3
    %c-4_i3 = hw.constant -4 : i3
    %c3_i3 = hw.constant 3 : i3
    %c2_i3 = hw.constant 2 : i3
    %c1_i3 = hw.constant 1 : i3
    %false = hw.constant false
    %c1_i8 = hw.constant 1 : i8
    %c0_i8 = hw.constant 0 : i8
    %clk_i_0 = llhd.sig name "clk_i" %false : i1
    %2 = llhd.prb %clk_i_0 : i1
    %rst_ni_1 = llhd.sig name "rst_ni" %false : i1
    %3 = llhd.prb %rst_ni_1 : i1
    %wkup_en_i_2 = llhd.sig name "wkup_en_i" %false : i1
    %wkup_mode_i_3 = llhd.sig name "wkup_mode_i" %c0_i3 : i3
    %aon_wkup_pulse_o = llhd.sig %false : i1
    %filter_out_d = llhd.sig %false : i1
    %filter_out_q = llhd.sig %false : i1
    %rising = llhd.sig %false : i1
    %falling = llhd.sig %false : i1
    %cnt_en = llhd.sig %false : i1
    %cnt_eq_th = llhd.sig %false : i1
    %cnt_d = llhd.sig %c0_i8 : i8
    %cnt_q = llhd.sig %c0_i8 : i8
    %u_prim_filter.filter_o = hw.instance "u_prim_filter" @prim_filter(clk_i: %2: i1, rst_ni: %3: i1, enable_i: %filter_en_i: i1, filter_i: %pin_value_i: i1) -> (filter_o: i1)
    llhd.drv %filter_out_d, %u_prim_filter.filter_o after %1 : i1
    %4 = llhd.prb %filter_out_d : i1
    %5 = comb.xor %4, %true : i1
    %6 = llhd.prb %filter_out_q : i1
    %7 = comb.and %5, %6 : i1
    llhd.drv %falling, %7 after %1 : i1
    %8 = comb.xor %6, %true : i1
    %9 = comb.and %4, %8 : i1
    llhd.drv %rising, %9 after %1 : i1
    %10 = llhd.prb %cnt_eq_th : i1
    %11 = llhd.prb %cnt_en : i1
    %12 = llhd.prb %cnt_q : i8
    %13 = comb.add %12, %c1_i8 : i8
    %14 = comb.xor %11, %true : i1
    %15 = comb.or %10, %14 : i1
    %16 = comb.mux %15, %c0_i8, %13 : i8
    llhd.drv %cnt_d, %16 after %1 : i8
    %17 = comb.icmp uge %12, %wkup_cnt_th_i : i8
    llhd.drv %cnt_eq_th, %17 after %1 : i1
    %18 = llhd.prb %aon_wkup_pulse_o : i1
    %19 = llhd.prb %wkup_en_i_2 : i1
    %20 = llhd.prb %wkup_mode_i_3 : i3
    %21 = llhd.prb %falling : i1
    %22 = llhd.prb %rising : i1
    llhd.process {
      cf.br ^bb1
    ^bb1:  // 2 preds: ^bb0, ^bb11
      llhd.drv %aon_wkup_pulse_o, %false after %1 : i1
      llhd.drv %cnt_en, %false after %1 : i1
      %23 = llhd.prb %wkup_en_i_2 : i1
      cf.cond_br %23, ^bb2, ^bb11
    ^bb2:  // pred: ^bb1
      %24 = llhd.prb %wkup_mode_i_3 : i3
      %25 = comb.icmp ceq %24, %c1_i3 : i3
      cf.cond_br %25, ^bb3, ^bb4
    ^bb3:  // pred: ^bb2
      %26 = llhd.prb %falling : i1
      llhd.drv %aon_wkup_pulse_o, %26 after %1 : i1
      cf.br ^bb11
    ^bb4:  // pred: ^bb2
      %27 = comb.icmp ceq %24, %c2_i3 : i3
      cf.cond_br %27, ^bb5, ^bb6
    ^bb5:  // pred: ^bb4
      %28 = llhd.prb %rising : i1
      %29 = llhd.prb %falling : i1
      %30 = comb.or %28, %29 : i1
      llhd.drv %aon_wkup_pulse_o, %30 after %1 : i1
      cf.br ^bb11
    ^bb6:  // pred: ^bb4
      %31 = comb.icmp ceq %24, %c3_i3 : i3
      cf.cond_br %31, ^bb7, ^bb8
    ^bb7:  // pred: ^bb6
      %32 = llhd.prb %filter_out_d : i1
      llhd.drv %cnt_en, %32 after %1 : i1
      %33 = llhd.prb %cnt_eq_th : i1
      llhd.drv %aon_wkup_pulse_o, %33 after %1 : i1
      cf.br ^bb11
    ^bb8:  // pred: ^bb6
      %34 = comb.icmp ceq %24, %c-4_i3 : i3
      cf.cond_br %34, ^bb9, ^bb10
    ^bb9:  // pred: ^bb8
      %35 = llhd.prb %filter_out_d : i1
      %36 = comb.xor %35, %true : i1
      llhd.drv %cnt_en, %36 after %1 : i1
      %37 = llhd.prb %cnt_eq_th : i1
      llhd.drv %aon_wkup_pulse_o, %37 after %1 : i1
      cf.br ^bb11
    ^bb10:  // pred: ^bb8
      %38 = llhd.prb %rising : i1
      llhd.drv %aon_wkup_pulse_o, %38 after %1 : i1
      cf.br ^bb11
    ^bb11:  // 6 preds: ^bb1, ^bb3, ^bb5, ^bb7, ^bb9, ^bb10
      llhd.wait (%18, %11, %19, %20, %21, %22, %4, %10 : i1, i1, i1, i3, i1, i1, i1, i1), ^bb1
    }
    llhd.process {
      cf.br ^bb1
    ^bb1:  // 4 preds: ^bb0, ^bb2, ^bb4, ^bb5
      %23 = llhd.prb %clk_i_0 : i1
      %24 = llhd.prb %rst_ni_1 : i1
      llhd.wait (%2, %3 : i1, i1), ^bb2
    ^bb2:  // pred: ^bb1
      %25 = llhd.prb %clk_i_0 : i1
      %26 = comb.xor bin %23, %true : i1
      %27 = comb.and bin %26, %25 : i1
      %28 = llhd.prb %rst_ni_1 : i1
      %29 = comb.xor bin %28, %true : i1
      %30 = comb.and bin %24, %29 : i1
      %31 = comb.or bin %27, %30 : i1
      cf.cond_br %31, ^bb3, ^bb1
    ^bb3:  // pred: ^bb2
      %32 = llhd.prb %rst_ni_1 : i1
      %33 = comb.xor %32, %true : i1
      cf.cond_br %33, ^bb4, ^bb5
    ^bb4:  // pred: ^bb3
      llhd.drv %filter_out_q, %false after %0 : i1
      llhd.drv %cnt_q, %c0_i8 after %0 : i8
      cf.br ^bb1
    ^bb5:  // pred: ^bb3
      %34 = llhd.prb %filter_out_d : i1
      llhd.drv %filter_out_q, %34 after %0 : i1
      %35 = llhd.prb %cnt_d : i8
      llhd.drv %cnt_q, %35 after %0 : i8
      cf.br ^bb1
    }
    llhd.drv %clk_i_0, %clk_i after %1 : i1
    llhd.drv %rst_ni_1, %rst_ni after %1 : i1
    llhd.drv %wkup_en_i_2, %wkup_en_i after %1 : i1
    llhd.drv %wkup_mode_i_3, %wkup_mode_i after %1 : i3
