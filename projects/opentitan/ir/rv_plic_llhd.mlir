    %alert_test = hw.struct_extract %u_reg.reg2hw["alert_test"] : !hw.struct<prio: !hw.array<186xstruct<q: i2>>, ie0: !hw.array<186xstruct<q: i1>>, threshold0: !hw.struct<q: i2>, cc0: !hw.struct<q: i8, qe: i1, re: i1>, msip0: !hw.struct<q: i1>, alert_test: !hw.struct<q: i1, qe: i1>>
