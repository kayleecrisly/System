  hw.module private @rv_plic_target(in %clk_i : i1, in %rst_ni : i1, in %ip_i : i186, in %ie_i : i186, in %prio_i : !hw.array<186xi2>, in %threshold_i : i2, out irq_o : i1, out irq_id_o : i8) {
    %0 = llhd.constant_time <0ns, 1d, 0e>
    %true = hw.constant true
    %1 = llhd.constant_time <0ns, 0d, 1e>
    %c0_i8 = hw.constant 0 : i8
    %false = hw.constant false
    %clk_i_0 = llhd.sig name "clk_i" %false : i1
    %2 = llhd.prb %clk_i_0 : i1
    %rst_ni_1 = llhd.sig name "rst_ni" %false : i1
    %3 = llhd.prb %rst_ni_1 : i1
    %max_valid = llhd.sig %false : i1
    %max_idx = llhd.sig %c0_i8 : i8
    %irq_d = llhd.sig %false : i1
    %irq_q = llhd.sig %false : i1
    %irq_id_d = llhd.sig %c0_i8 : i8
    %irq_id_q = llhd.sig %c0_i8 : i8
    %4 = comb.and %ip_i, %ie_i : i186
    %u_prim_max_tree.max_value_o, %u_prim_max_tree.max_idx_o, %u_prim_max_tree.max_valid_o = hw.instance "u_prim_max_tree" @prim_max_tree(clk_i: %2: i1, rst_ni: %3: i1, values_i: %prio_i: !hw.array<186xi2>, valid_i: %4: i186) -> (max_value_o: i2, max_idx_o: i8, max_valid_o: i1) {sv.namehint = "max_value"}
    llhd.drv %max_idx, %u_prim_max_tree.max_idx_o after %1 : i8
    llhd.drv %max_valid, %u_prim_max_tree.max_valid_o after %1 : i1
    %5 = comb.icmp ugt %u_prim_max_tree.max_value_o, %threshold_i : i2
    %6 = llhd.prb %max_valid : i1
    %7 = comb.and %5, %6 : i1
    llhd.drv %irq_d, %7 after %1 : i1
    %8 = llhd.prb %max_idx : i8
    %9 = comb.mux %6, %8, %c0_i8 : i8
    llhd.drv %irq_id_d, %9 after %1 : i8
    llhd.process {
      cf.br ^bb1
    ^bb1:  // 4 preds: ^bb0, ^bb2, ^bb4, ^bb5
      %12 = llhd.prb %clk_i_0 : i1
      %13 = llhd.prb %rst_ni_1 : i1
      llhd.wait (%2, %3 : i1, i1), ^bb2
    ^bb2:  // pred: ^bb1
      %14 = llhd.prb %clk_i_0 : i1
      %15 = comb.xor bin %12, %true : i1
      %16 = comb.and bin %15, %14 : i1
      %17 = llhd.prb %rst_ni_1 : i1
      %18 = comb.xor bin %17, %true : i1
      %19 = comb.and bin %13, %18 : i1
      %20 = comb.or bin %16, %19 : i1
      cf.cond_br %20, ^bb3, ^bb1
    ^bb3:  // pred: ^bb2
      %21 = llhd.prb %rst_ni_1 : i1
      %22 = comb.xor %21, %true : i1
      cf.cond_br %22, ^bb4, ^bb5
    ^bb4:  // pred: ^bb3
      llhd.drv %irq_q, %false after %0 : i1
      llhd.drv %irq_id_q, %c0_i8 after %0 : i8
      cf.br ^bb1
    ^bb5:  // pred: ^bb3
      %23 = llhd.prb %irq_d : i1
      llhd.drv %irq_q, %23 after %0 : i1
      %24 = llhd.prb %irq_id_d : i8
      llhd.drv %irq_id_q, %24 after %0 : i8
      cf.br ^bb1
    }
    %10 = llhd.prb %irq_q : i1
    %11 = llhd.prb %irq_id_q : i8
    llhd.drv %clk_i_0, %clk_i after %1 : i1
    llhd.drv %rst_ni_1, %rst_ni after %1 : i1
    hw.output %10, %11 : i1, i8
  }
}
