      %76 = llhd.prb %cfg_pinflip_i_3 : !hw.inout<i1>
      %77 = llhd.prb %usb_d_d : !hw.inout<i1>
      %78 = comb.xor %76, %77 : i1
      %79 = llhd.prb %usb_se0_d : !hw.inout<i1>
      %80 = comb.xor %79, %true : i1
      %81 = comb.and %78, %80 : i1
      llhd.drv %usb_dp_flipped, %81 after %0 : !hw.inout<i1>
      %82 = llhd.prb %cfg_pinflip_i_3 : !hw.inout<i1>
      %83 = llhd.prb %usb_d_d : !hw.inout<i1>
      %84 = comb.xor %82, %83, %true : i1
      %85 = llhd.prb %usb_se0_d : !hw.inout<i1>
      %86 = comb.xor %85, %true : i1
      %87 = comb.and %84, %86 : i1
      llhd.drv %usb_dn_flipped, %87 after %0 : !hw.inout<i1>
      cf.br ^bb4
    ^bb4:  // 2 preds: ^bb2, ^bb3
      llhd.wait (%61, %67, %68, %69, %70, %55, %53 : i1, i1, i1, i1, i1, i1, i1), ^bb1
    }
    %u_usb_d_o_flop.q_o = hw.instance "u_usb_d_o_flop" @prim_flop_39(clk_i: %2: i1, rst_ni: %3: i1, d_i: %69: i1) -> (q_o: i1)
    %u_usb_se0_o_flop.q_o = hw.instance "u_usb_se0_o_flop" @prim_flop(clk_i: %2: i1, rst_ni: %3: i1, d_i: %67: i1) -> (q_o: i1)
    %u_usb_dp_o_flop.q_o = hw.instance "u_usb_dp_o_flop" @prim_flop_39(clk_i: %2: i1, rst_ni: %3: i1, d_i: %69: i1) -> (q_o: i1)
    %u_usb_dn_o_flop.q_o = hw.instance "u_usb_dn_o_flop" @prim_flop(clk_i: %2: i1, rst_ni: %3: i1, d_i: %70: i1) -> (q_o: i1)
    llhd.drv %clk_i_0, %clk_i after %0 : !hw.inout<i1>
    llhd.drv %rst_ni_1, %rst_ni after %0 : !hw.inout<i1>
    llhd.drv %link_reset_i_2, %link_reset_i after %0 : !hw.inout<i1>
