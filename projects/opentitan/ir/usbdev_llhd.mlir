    hw.output %56, %u_usb_d_o_flop.q_o, %u_usb_se0_o_flop.q_o, %u_usb_dp_o_flop.q_o, %u_usb_dn_o_flop.q_o, %22, %30 : i1, i1, i1, i1, i1, i1, i1
