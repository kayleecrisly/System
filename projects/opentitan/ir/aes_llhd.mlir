    hw.output %27, %32, %u_reg.tl_o, %33 : i4, !hw.struct<edn_req: i1>, !hw.struct<d_valid: i1, d_opcode: i3, d_param: i3, d_size: i2, d_source: i8, d_sink: i1, d_data: i32, d_user: !hw.struct<rsp_intg: i7, data_intg: i7>, d_error: i1, a_ready: i1>, !hw.array<2xstruct<alert_p: i1, alert_n: i1>>
  }
}
