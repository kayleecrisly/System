    %38 = llhd.sig.array_get %lc_en_o[%c-4_i3] : <!hw.array<6xi4>>
    %39 = llhd.prb %gen_buffs_4.lc_en_out : i4
    llhd.drv %38, %39 after %0 : i4
    %40 = llhd.sig.array_get %lc_en_o[%c-3_i3] : <!hw.array<6xi4>>
    %41 = llhd.prb %gen_buffs_5.lc_en_out : i4
    llhd.drv %40, %41 after %0 : i4
    %42 = llhd.prb %lc_en_o : !hw.array<6xi4>
    hw.output %42 : !hw.array<6xi4>
  }
}
