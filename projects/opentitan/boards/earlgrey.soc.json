{
  "$schema_version": 1,
  "_doc": "SoC integration binding for OpenTitan Earl Grey QP devices. Maps each QEMU board device (qemu_dev enum) to its OT instance (ot_instance, for soc.digest.json lookup of base/PLIC/alert) + the model's irq_count (from the device irq_blueprint). Deterministic wiring (base/PLIC/alert) comes from soc.digest.json; qom_type is the [AI-2] glue (which generated model). See soc/SOC_SCHEMA.md.",
  "target": { "machine": "ot-earlgrey", "intc": "plic", "cpu": "ibex" },
  "devices": [
    { "name": "uart",       "qemu_dev": "OT_EG_SOC_DEV_UART0",      "ot_instance": "uart0",         "irq_count": 9,  "qom_type": "TYPE_OT_UART_QP" },
    { "name": "gpio",       "qemu_dev": "OT_EG_SOC_DEV_GPIO",       "ot_instance": "gpio",          "irq_count": 32, "qom_type": "TYPE_OT_GPIO_QP" },
    { "name": "spi_device", "qemu_dev": "OT_EG_SOC_DEV_SPI_DEVICE", "ot_instance": "spi_device",    "irq_count": 8,  "qom_type": "TYPE_OT_SPI_DEVICE_QP" },
    { "name": "i2c",        "qemu_dev": "OT_EG_SOC_DEV_I2C0",       "ot_instance": "i2c0",          "irq_count": 10, "qom_type": "TYPE_OT_I2C_QP",
      "_note": "model irq_count=10 < top's 15 (IRQ 10..14 absent in this LLHD IR); wires PLIC 77..86, leaves 87..91 unconnected — intentional." },
    { "name": "pattgen",    "qemu_dev": "OT_EG_SOC_DEV_PATTGEN",    "ot_instance": "pattgen",       "irq_count": 2,  "qom_type": "TYPE_OT_PATTGEN_QP" },
    { "name": "rv_timer",   "qemu_dev": "OT_EG_SOC_DEV_TIMER",      "ot_instance": "rv_timer",      "irq_count": 1,  "qom_type": "TYPE_OT_RV_TIMER_QP" },
    { "name": "spi_host",   "qemu_dev": "OT_EG_SOC_DEV_SPI_HOST0",  "ot_instance": "spi_host0",     "irq_count": 2,  "qom_type": "TYPE_OT_SPI_HOST_QP" },
    { "name": "aon_timer",  "qemu_dev": "OT_EG_SOC_DEV_AON_TIMER",  "ot_instance": "aon_timer_aon", "irq_count": 2,  "qom_type": "TYPE_OT_AON_TIMER_QP" },
    { "name": "pwm",        "qemu_dev": "OT_EG_SOC_DEV_PWM",        "ot_instance": "pwm_aon",       "irq_count": 0,  "qom_type": "TYPE_OT_PWM_QP" },
    { "name": "pinmux",     "qemu_dev": "OT_EG_SOC_DEV_PINMUX",     "ot_instance": "pinmux_aon",    "irq_count": 0,  "qom_type": "TYPE_OT_PINMUX_QP" }
  ]
}
