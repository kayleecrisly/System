#!/usr/bin/env bash
set -euo pipefail
experiment_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
workspace_dir=$(cd -- "$experiment_dir/../../../.." && pwd)
source_dir="$workspace_dir/opentitan"
environment_dir=/home/kaylee/circt-workspace/environments/opentitan
toolchain_dir="$environment_dir/lowrisc-20251111-1"
clang="$toolchain_dir/bin/riscv32-unknown-elf-clang"
private_src="$experiment_dir/src/rv_timer/baseline"
build_dir="$experiment_dir/build/rv_timer-baseline"
results_dir="$workspace_dir/System/results/opentitan/rtl-c751059925/rv_timer-baseline/firmware"
expected_commit=c7510599254dcbaa6153468e696aa11299cb5b5f
test "$(git -C "$source_dir" rev-parse HEAD)" = "$expected_commit"
git -C "$source_dir" diff --quiet HEAD -- sw/device util/reggen util/make_new_dif \
  util/dtgen util/dttool.py hw/ip/rv_timer/data/rv_timer.hjson \
  hw/ip/sram_ctrl/data/sram_ctrl.hjson hw/top_earlgrey/data/autogen/top_earlgrey.gen.hjson \
  hw/top_earlgrey/sw/dt/sim_dv.c \
  hw/top_earlgrey/ip_autogen/rv_core_ibex/data/rv_core_ibex.hjson \
  hw/top_earlgrey/ip_autogen/rv_plic/data/rv_plic.hjson
test -x "$clang"
mkdir -p "$build_dir/objects" "$private_src/official" "$results_dir"
cp "$source_dir/sw/device/tests/rv_timer_smoketest.c" "$private_src/official/rv_timer_smoketest.c"
cmp "$source_dir/sw/device/tests/rv_timer_smoketest.c" "$private_src/official/rv_timer_smoketest.c"
export PYTHONPATH="$environment_dir/rv-timer-baseline-python-deps"
"$environment_dir/python/bin/python" "$private_src/generate_headers.py" "$source_dir" "$build_dir/generated"
common=(--target=riscv32-unknown-elf -march=rv32imc -mabi=ilp32
  -mcmodel=medany -ffreestanding -fno-builtin -fno-stack-protector
  -ffile-prefix-map="$workspace_dir/"=
  -ffunction-sections -fdata-sections -O2 -g -nostdinc -DOT_PLATFORM_RV32
  -I"$build_dir/generated" -I"$source_dir"
  -I"$source_dir/sw/device/lib/dif" -isystem "$source_dir/sw/device/lib/base/freestanding"
  -isystem "$($clang -print-resource-dir)/include")
sources=(
  "$private_src/official/rv_timer_smoketest.c"
  "$source_dir/sw/device/lib/dif/dif_rv_timer.c"
  "$source_dir/sw/device/lib/dif/dif_rv_plic.c"
  "$build_dir/generated/sw/device/lib/dif/autogen/dif_rv_timer_autogen.c"
  "$build_dir/generated/sw/device/lib/dif/autogen/dif_rv_plic_autogen.c"
  "$build_dir/generated/hw/top/dt/api.c"
  "$build_dir/generated/hw/top/dt/rv_timer.c"
  "$build_dir/generated/hw/top/dt/rv_plic.c"
  "$build_dir/generated/hw/top/dt/rv_core_ibex.c"
  "$build_dir/generated/hw/top/dt/sram_ctrl.c"
  "$source_dir/hw/top_earlgrey/sw/dt/sim_dv.c"
  "$source_dir/sw/device/lib/base/math.c"
  "$source_dir/sw/device/lib/base/memory.c"
  "$source_dir/sw/device/lib/base/status.c"
  "$source_dir/sw/device/lib/arch/device_sim_dv.c"
  "$source_dir/sw/device/lib/runtime/hart.c"
  "$source_dir/sw/device/lib/runtime/irq.c"
  "$source_dir/sw/device/lib/runtime/ibex.c"
  "$source_dir/sw/device/lib/runtime/log.c"
  "$source_dir/sw/device/lib/runtime/print.c"
  "$source_dir/sw/device/lib/testing/test_framework/status.c"
  "$source_dir/sw/device/lib/testing/test_framework/ottf_start.S"
  "$source_dir/sw/device/lib/testing/test_framework/ottf_isrs.S"
  "$source_dir/sw/device/lib/testing/test_framework/ottf_isrs.c"
  "$source_dir/sw/device/lib/crt/crt.S"
  "$private_src/runtime.c")
objects=()
for source in "${sources[@]}"; do
  object="$build_dir/objects/${#objects[@]}-$(basename -- "$source").o"
  "$clang" "${common[@]}" -std=gnu11 -MD -MF "$object.d" -c "$source" -o "$object"
  objects+=("$object")
done
"$clang" --target=riscv32-unknown-elf -march=rv32imc -mabi=ilp32 \
  -nostdlib -fuse-ld=lld "${objects[@]}" -Wl,--gc-sections \
  -Wl,-Map,"$build_dir/rv_timer_smoketest.map" -Wl,-T,"$private_src/link.ld" \
  -o "$build_dir/rv_timer_smoketest.elf"
"$toolchain_dir/bin/riscv32-unknown-elf-objcopy" -O binary "$build_dir/rv_timer_smoketest.elf" "$build_dir/rv_timer_smoketest.bin"
"$toolchain_dir/bin/riscv32-unknown-elf-objdump" -d "$build_dir/rv_timer_smoketest.elf" > "$build_dir/rv_timer_smoketest.dis"
"$environment_dir/python/bin/python" "$private_src/record_build.py" "$source_dir" "$build_dir" "$toolchain_dir" "$results_dir"
sha256sum "$build_dir/rv_timer_smoketest.elf" "$private_src/official/rv_timer_smoketest.c"
